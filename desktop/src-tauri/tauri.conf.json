{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LayoutLingua",
  "version": "2.1.1",
  "identifier": "com.layoutlingua.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LayoutLingua — Layout-Aware Document Translation",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://127.0.0.1:8765 http://localhost:*; img-src 'self' data: blob: http://127.0.0.1:8765 http://localhost:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:8765 http://localhost:* https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
